{
  "name": "volar-desktop",
  "productName": "VOLAR",
  "version": "0.5.28",
  "description": "VOLAR for the shop's computers: its own program, working with or without internet.",
  "private": true,
  "main": "src/main.js",
  "author": "VOLAR",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --profile=dev --ui=http://localhost:3002 --api=http://localhost:4000/v1",
    "dev:packaged-ui": "electron . --profile=dev --api=http://localhost:4000/v1",
    "build:ui": "node scripts/build-ui.mjs",
    "dist": "npm run build:ui && electron-builder --win nsis",
    "release": "npm run build:ui && node scripts/ensure-release.mjs && electron-builder --win nsis --publish always",
    "dist:mac": "npm run build:ui && electron-builder --mac",
    "release:mac": "npm run build:ui && node scripts/ensure-release.mjs && electron-builder --mac --publish always"
  },
  "build": {
    "appId": "com.volar.desktop",
    "productName": "VOLAR",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "VOLAR",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": "-",
      "hardenedRuntime": false,
      "artifactName": "VOLAR-${version}-mac-${arch}.${ext}"
    },
    "dmg": {
      "title": "VOLAR",
      "artifactName": "VOLAR-${version}-mac-${arch}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "mohaamedwasfy",
        "repo": "volar-desktop",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "ui",
        "to": "ui",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mohaamedwasfy/volar-desktop.git"
  }
}
